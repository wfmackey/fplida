TARGET_DIR = ./rust/target
LIBDIR = $(TARGET_DIR)/release
STATLIB = $(LIBDIR)/libfplida.a
PKG_LIBS = -L$(LIBDIR) -lfplida

# There is deliberately no `all: C_clean` rule. R merges that into shlib.mk's
# `all: $(SHLIB)` as two unordered prerequisites, so under `make -j` the clean
# recipe can delete the shared object that was just linked. .NOTPARALLEL would
# fix that, but it is a GNU extension and R CMD check reports it.
#
# The pre-clean was also the only thing forcing cargo to re-run: $(STATLIB) is
# a file target with no prerequisites, so make treats an existing archive as
# permanently up to date and silently links stale Rust. The FORCE prerequisite
# below makes make always enter the recipe and lets cargo decide what needs
# rebuilding. FORCE is used rather than .PHONY because it works on any make,
# and because it still lets make skip the relink when the archive is unchanged.

$(SHLIB): $(STATLIB)

CARGOTMP = $(CURDIR)/.cargo

$(STATLIB): FORCE
	# Report Rust toolchain versions (CRAN policy)
	@export PATH="$(PATH):$(HOME)/.cargo/bin" && \
		echo "using Rust package manager: '$$(cargo --version)'" && \
		echo "using Rust compiler: '$$(rustc --version)'"
	# In some environments, ~/.cargo/bin might not be in PATH, so we need
	# to set it here to ensure cargo can be found.
	if [ "$(NOT_CRAN)" != "true" ]; then \
		export CARGO_HOME=$(CARGOTMP); \
	fi && \
		export PATH="$(PATH):$(HOME)/.cargo/bin" && \
		cargo build --lib --release --locked \
			--manifest-path=./rust/Cargo.toml --target-dir $(TARGET_DIR)
	if [ "$(NOT_CRAN)" != "true" ]; then \
		rm -Rf $(CARGOTMP) && \
		rm -Rf $(LIBDIR)/build; \
	fi

FORCE:

clean:
	rm -Rf $(SHLIB) $(STATLIB) $(OBJECTS) $(TARGET_DIR)
